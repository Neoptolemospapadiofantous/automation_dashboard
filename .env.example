APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/dev runs on SQLite (zero-config). Production target is MySQL:
# flip DB_CONNECTION to mysql and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=automation_dashboard
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time broadcasting.
# Default here is "pusher" (managed, zero-ops). Because both Pusher and the
# self-hosted Laravel Reverb server speak the SAME protocol, switching to a
# self-hosted Reverb later is just an env change + `php artisan install:broadcasting --reverb`.
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
# Local dev: leave MAIL_MAILER=log → emails dump to storage/logs/laravel.log.
# Production: set MAIL_MAILER=ses and provide AWS credentials below.
#
# SES setup runbook (one-time, ~30 min):
#   1. AWS Console → SES → Verified identities → Create identity → Domain.
#      Pick the sending domain (e.g. mail.flowstack.com).
#   2. Copy the CNAME records SES gives you → add to your DNS.
#      DKIM verifies within minutes. Once verified, SES will sign all mail.
#   3. (Production) AWS Console → SES → Account dashboard → "Request production access"
#      Sandbox accounts can only send to other verified addresses.
#      The form takes ~24h to approve.
#   4. AWS Console → IAM → Users → create one with the AmazonSESFullAccess policy.
#      Save the access key + secret here.
#   5. MAIL_FROM_ADDRESS must be on the verified domain (e.g. hello@mail.flowstack.com).
#   6. Verify locally: php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (S3 + SES share these credentials) ---------------------------------
# For SES specifically, the IAM user only needs AmazonSESFullAccess.
# Use us-east-1 unless you have a regional preference — SES is cheapest there
# and the deliverability monitoring tools have the most coverage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Real-time (Pusher) -------------------------------------------------------
# Create a free app at https://dashboard.pusher.com and paste the credentials.
# For data-residency, pick an EU cluster (e.g. eu) and sign Pusher's DPA.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# --- To self-host with Laravel Reverb instead (full data ownership) -----------
# Set BROADCAST_CONNECTION=reverb and provide these; Echo reads the same vars.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

# --- Voiceflow ----------------------------------------------------------------
#
# IMPORTANT: Voiceflow only has ONE type of API key — a per-PROJECT
# Dialog Manager key (prefix VF.DM.*). There is no separate "workspace"
# key (confirmed by Voiceflow support 2026-06-10). The DM key authenticates
# everything for that project: Runtime / Conversations / State / Session,
# Knowledge Base CRUD + query, Analytics (usage + transcripts), and
# Project / Environment management.
#
# In managed mode (default), every agent has its own DM key + project ID
# stored encrypted on the `agents` table (voiceflow_api_key,
# voiceflow_project_id). The pool allocator
# (php artisan vf:pool:add) is operator-manual: you create each project
# in the Voiceflow dashboard, copy its DM key + project ID, then the
# command stores them on a free pool row. CreateAgent assigns the next
# free row to each new tenant.
#
# What you actually need to set: nothing here. Just create projects in
# the Voiceflow dashboard, top up the pool with `php artisan vf:pool:add`,
# and signups consume from the pool automatically.

# Pool-based provisioning. Leave true unless wiring a Custom-tier
# customer's own workspace (BYOK). See docs/phase-13-multitenancy.md.
VOICEFLOW_MANAGED=true
VOICEFLOW_ENVIRONMENT=main
VOICEFLOW_RUNTIME_URL=https://general-runtime.voiceflow.com
VOICEFLOW_API_URL=https://api.voiceflow.com
VOICEFLOW_ANALYTICS_URL=https://analytics-api.voiceflow.com
VOICEFLOW_REALTIME_URL=https://realtime-api.voiceflow.com

# Vestigial (kept for backwards compatibility). Production leaves all
# three blank — the agent's DM key handles every authenticated surface.
# VOICEFLOW_WORKSPACE_API_KEY=  (Voiceflow has no such key — falls back to DM key anyway)
# VOICEFLOW_API_KEY=             (ops-only env fallback for tinker / global jobs)
# VOICEFLOW_PROJECT_ID=          (ops-only env fallback for tinker / global jobs)

# Legacy: a global webhook secret used by Phase 13's backfill migration to
# seed each team's default agent. The active webhook surface
# (api/voiceflow/lead-captured/{agent}) authenticates per-agent, so this is
# only consumed once during migration and may be left blank in fresh deploys.
VOICEFLOW_WEBHOOK_SECRET=

# --- Stripe (subscriptions + topups) ------------------------------------------
# Test mode: use pk_test_* + sk_test_* from dashboard.stripe.com/test/apikeys.
# Live mode: pk_live_* + sk_live_* from dashboard.stripe.com/apikeys
# (only after activating live mode in Stripe and filling in business info).
# Webhook secret:
#   - Local dev: run `stripe listen --forward-to localhost:8000/webhooks/stripe`
#     and copy the whsec_* the CLI prints.
#   - Prod: dashboard.stripe.com/webhooks → add endpoint → copy the signing secret.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia

# Stripe price IDs — created at dashboard.stripe.com/test/products.
# Subscription tiers — monthly (recurring):
STRIPE_PRICE_STARTER=
STRIPE_PRICE_OPERATOR=
# Subscription tiers — annual (recurring, ~17% discount). Optional: leave
# blank to hide the Monthly/Annual toggle on the Billing page entirely.
# Create as a second price on the SAME Stripe Product, with interval=year:
#   Starter:  $948/yr  ($99 × 12 × 0.83)
#   Operator: $3,828/yr ($399 × 12 × 0.83)
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_OPERATOR_ANNUAL=
# Top-up packs (one-time, additional credits):
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=

# --- Conversation search (Laravel Scout) --------------------------------------
# Leave SCOUT_DRIVER empty for the zero-infra DB fallback (LIKE scan). Set to
# "typesense" in production for fast keyword + semantic (hybrid) search.
SCOUT_DRIVER=
SCOUT_QUEUE=true
TYPESENSE_API_KEY=
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# --- Vite (frontend reads these for Laravel Echo) -----------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Native runtime (Flowstack-owned conversational engine) -------------------
# RUNTIME_DEFAULT_MODE=native → NEW agents are provisioned on our own engine:
# no Voiceflow pool, active immediately. Existing agents keep their current
# runtime_mode. Set to 'voiceflow' to fall back to the legacy pool path.
RUNTIME_DEFAULT_MODE=native
# Agents with runtime_mode='native' are served by our own LLM loop instead of
# Voiceflow. Two provider keys are required:
#   ANTHROPIC_API_KEY — console.anthropic.com → API keys. Powers the chat loop.
#   OPENAI_API_KEY    — platform.openai.com → API keys. Powers KB embeddings
#                       only (text-embedding-3-small, ~$0.02/1M tokens).
# Cost ballpark: ~$0.005-0.01 per customer message (Haiku default model).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional overrides (sane defaults in config/runtime.php):
# ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_COMPLEX=claude-sonnet-4-6
# RUNTIME_TOP_K=5
# RUNTIME_MAX_TOOL_CALLS=10
# RUNTIME_MAX_TURNS=100
