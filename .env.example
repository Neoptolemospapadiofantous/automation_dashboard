APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local/dev runs on SQLite (zero-config). Production target is MySQL:
# flip DB_CONNECTION to mysql and fill in the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=automation_dashboard
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time broadcasting.
# Default here is "pusher" (managed, zero-ops). Because both Pusher and the
# self-hosted Laravel Reverb server speak the SAME protocol, switching to a
# self-hosted Reverb later is just an env change + `php artisan install:broadcasting --reverb`.
BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Real-time (Pusher) -------------------------------------------------------
# Create a free app at https://dashboard.pusher.com and paste the credentials.
# For data-residency, pick an EU cluster (e.g. eu) and sign Pusher's DPA.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# --- To self-host with Laravel Reverb instead (full data ownership) -----------
# Set BROADCAST_CONNECTION=reverb and provide these; Echo reads the same vars.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http

# --- Voiceflow (server-proxied Dialog Manager API) ----------------------------
# Generate a Dialog Manager key (prefix VF.DM.*) in your Voiceflow project:
# Settings -> API keys. Kept server-side only; never exposed to the browser.
VOICEFLOW_API_KEY=
# Optional. Workspace-scoped key for analytics/transcripts + KB endpoints.
# Falls back to VOICEFLOW_API_KEY (which 401s on most workspace surfaces).
# Per-tenant value lives on the Agent model — this is the global fallback
# used by CLI commands and pre-onboarding code paths.
VOICEFLOW_WORKSPACE_API_KEY=
VOICEFLOW_ENVIRONMENT=main
VOICEFLOW_PROJECT_ID=
VOICEFLOW_RUNTIME_URL=https://general-runtime.voiceflow.com
VOICEFLOW_API_URL=https://api.voiceflow.com
VOICEFLOW_ANALYTICS_URL=https://analytics-api.voiceflow.com
VOICEFLOW_REALTIME_URL=https://realtime-api.voiceflow.com
# Shared secret for the Custom Action capture webhook (api/voiceflow/lead-captured).
# Set the same value in your Voiceflow agent's X-Webhook-Secret header.
VOICEFLOW_WEBHOOK_SECRET=

# --- Conversation search (Laravel Scout) --------------------------------------
# Leave SCOUT_DRIVER empty for the zero-infra DB fallback (LIKE scan). Set to
# "typesense" in production for fast keyword + semantic (hybrid) search.
SCOUT_DRIVER=
SCOUT_QUEUE=true
TYPESENSE_API_KEY=
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# --- Vite (frontend reads these for Laravel Echo) -----------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
