APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Pre-launch gate. true → the whole app shows a "coming soon" page and
# login/register are blocked (machine endpoints api/*, webhooks/*, up stay
# open). Set true in prod until launch; flip to false to open the app.
COMING_SOON=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB. Local dev + tests use it (see phpunit.xml for the test DB).
#   sudo apt install -y mariadb-server php8.4-mysql
#   sudo mariadb -e "CREATE DATABASE automation_dashboard CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#                    CREATE DATABASE automation_dashboard_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#                    CREATE USER 'flowstack'@'127.0.0.1' IDENTIFIED BY 'flowstack';
#                    GRANT ALL PRIVILEGES ON automation_dashboard.* TO 'flowstack'@'127.0.0.1';
#                    GRANT ALL PRIVILEGES ON automation_dashboard_test.* TO 'flowstack'@'127.0.0.1'; FLUSH PRIVILEGES;"
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_dashboard
DB_USERNAME=flowstack
DB_PASSWORD=flowstack
# SQLite (legacy zero-config fallback): DB_CONNECTION=sqlite  (then touch database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Real-time broadcasting via Laravel Reverb — the first-party, self-hosted
# WebSocket server (no third-party account; keys self-generated by
# `php artisan reverb:install`). Reverb config lives further down.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
# Local dev: leave MAIL_MAILER=log → emails dump to storage/logs/laravel.log.
#
# Production — TRANSACTIONAL email (lead alerts, human-handoff, password
# reset, email verification) sends through AWS SES via the SES API over HTTPS
# (no SMTP). Zoho is the human inbox only, not the app's sender.
#   MAIL_MAILER=ses
#   MAIL_FROM_ADDRESS=noreply@txn.<your-domain>  # must be @ the verified identity
#   MAIL_FROM_NAME="Flowstack"
#   AWS_ACCESS_KEY_ID=AKIA...                     # IAM user, ses:SendEmail only
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=eu-central-1
#   Verify: php artisan mail:test you@<verified-domain>
#
# SES one-time setup: SES (eu-central-1) → Verified identities → add the
# txn.<domain> domain identity → add the DKIM CNAMEs + custom MAIL FROM
# (bounce.txn SPF + MX) + _dmarc.txn → request production access. Transactional
# mail is queued on the "mail" queue (dedicated Email Worker). MARKETING/bulk
# is a separate future lane (own subdomain e.g. news.<domain>, bulk queue,
# unsubscribe) — not the transactional mailer above.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (S3 + SES share these credentials) ---------------------------------
# For SES specifically, the IAM user only needs AmazonSESFullAccess.
# Use us-east-1 unless you have a regional preference — SES is cheapest there
# and the deliverability monitoring tools have the most coverage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Real-time (Laravel Reverb — self-hosted, first-party) --------------------
# Generate the keys with `php artisan reverb:install` (it writes these). The
# Reverb server is a long-lived process: `php artisan reverb:start` locally, a
# Forge/supervisor daemon in prod. REVERB_HOST/PORT/SCHEME are what the BROWSER
# connects to (your public ws domain in prod, TLS terminated by the proxy).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Prod example: REVERB_HOST=ws.<your-domain>  REVERB_PORT=443  REVERB_SCHEME=https

# --- Stripe (subscriptions + topups) ------------------------------------------
# Test mode: use pk_test_* + sk_test_* from dashboard.stripe.com/test/apikeys.
# Live mode: pk_live_* + sk_live_* from dashboard.stripe.com/apikeys
# (only after activating live mode in Stripe and filling in business info).
# Webhook secret:
#   - Local dev: run `stripe listen --forward-to localhost:8000/webhooks/stripe`
#     and copy the whsec_* the CLI prints.
#   - Prod: dashboard.stripe.com/webhooks → add endpoint → copy the signing secret.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia

# Stripe price IDs — created at dashboard.stripe.com/test/products.
# Subscription tiers — monthly (recurring):
STRIPE_PRICE_STARTER=
STRIPE_PRICE_OPERATOR=
# Subscription tiers — annual (recurring, "2 months free"). Optional: leave
# blank to hide the Monthly/Annual toggle on the Billing page entirely.
# Create as a second price on the SAME Stripe Product, with interval=year:
#   Starter:  €990/yr  (€99 × 10)
#   Operator: €3,990/yr (€399 × 10)
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_OPERATOR_ANNUAL=
# Top-up packs (one-time, additional credits):
#   Small €29 / 1,000cr · Medium €119 / 5,000cr · Large €399 / 20,000cr
#   (must price ABOVE Operator's €/credit — see docs/operations/pricing-audit.md)
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_MEDIUM=
STRIPE_PRICE_TOPUP_LARGE=
# Custom top-up: one price with custom_unit_amount (€10–€2,000, chosen on
# Stripe's hosted page). Credits = amount × 50 (€0.02/credit).
STRIPE_PRICE_TOPUP_CUSTOM=

# --- Conversation search (Laravel Scout) --------------------------------------
# Leave SCOUT_DRIVER empty for the zero-infra DB fallback (LIKE scan). Set to
# "typesense" in production for fast keyword + semantic (hybrid) search.
SCOUT_DRIVER=
SCOUT_QUEUE=true
TYPESENSE_API_KEY=
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# --- Vite (frontend reads these for Laravel Echo → Reverb) --------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Native runtime (Flowstack-owned conversational engine) -------------------
# The native engine is THE engine. Two provider keys are required:
#   ANTHROPIC_API_KEY — console.anthropic.com → API keys. Powers the chat loop.
#   OPENAI_API_KEY    — platform.openai.com → API keys. Powers KB embeddings
#                       only (text-embedding-3-small, ~$0.02/1M tokens).
# Cost ballpark: ~$0.005-0.01 per customer message (Haiku default model).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional third provider — unlocks the Gemini tier in the model picker.
# aistudio.google.com/apikey. Leave blank to grey the tier out in the UI.
GEMINI_API_KEY=
# Optional overrides (sane defaults in config/runtime.php):
# ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
# RUNTIME_TOP_K=5
# RUNTIME_MAX_TOOL_CALLS=10
# RUNTIME_MAX_TURNS=100

# DEV/TEST ONLY: grant a team its plan credits on creation, since the Stripe
# subscribe->webhook->grant lifecycle never fires without Stripe configured.
# Keep FALSE in production (would mint unpaid-for credits). See config/billing.php.
BILLING_GRANT_ON_SIGNUP=false
