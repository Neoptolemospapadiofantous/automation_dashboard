<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Wiring">
            <directory>tests/Wiring</directory>
        </testsuite>
        <testsuite name="Integrity">
            <directory>tests/Integrity</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
        <testsuite name="Security">
            <directory>tests/Security</directory>
        </testsuite>
        <testsuite name="Contracts">
            <directory>tests/Contracts</directory>
        </testsuite>
        <testsuite name="Snapshots">
            <directory>tests/Snapshots</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Dedicated test database — NEVER the dev DB. Combined with the
             config:clear before the test step in scripts/hermes.sh (a stale
             config:cache pointing at the dev DB is what once let a test run
             wipe dev data). -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="automation_dashboard_test"/>
        <env name="DB_USERNAME" value="flowstack"/>
        <env name="DB_PASSWORD" value="flowstack"/>
        <env name="DB_URL" value=""/>
        <!-- Pin runtime LLM/embedding config to product defaults so a
             developer's local overrides (e.g. a local Ollama server in .env)
             can't break the runtime test suite. -->
        <env name="OPENAI_BASE_URL" value="https://api.openai.com"/>
        <!-- Bridge OFF in tests: with the local .env bridge-enabled (2026-07-31),
             unfaked turns would leak to the REAL local claude-bridge and answer
             with live LLM text. Tests that exercise the bridge enable it via
             config() explicitly (BridgeClientTest). -->
        <env name="CLAUDE_BRIDGE_ENABLED" value="false"/>
        <env name="RUNTIME_EMBEDDINGS_MODEL" value="text-embedding-3-small"/>
        <env name="RUNTIME_EMBEDDINGS_DIMENSIONS" value="1536"/>
        <env name="RUNTIME_TIER_GPT_MODEL" value="gpt-5.1"/>
        <!-- Tests exercise the real Stripe credit lifecycle; the dev signup
             auto-grant (BILLING_GRANT_ON_SIGNUP, true in local .env) must be
             OFF here or it mints credits behind credit-balance assertions. -->
        <env name="BILLING_GRANT_ON_SIGNUP" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
