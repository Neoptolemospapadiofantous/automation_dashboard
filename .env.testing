# Test environment. Committed on purpose.
#
# WHY THIS FILE EXISTS: without it, `--env=testing` silently falls back to
# .env — so `php artisan migrate:fresh --env=testing` DROPS THE DEV DATABASE.
# phpunit.xml sets the test DB for PHPUnit runs only; it has no effect on
# artisan. That trap has cost real local data more than once (see the note in
# phpunit.xml). This file makes --env=testing mean what everyone assumes.
#
# It holds no secrets: the suite fakes every outbound call.

APP_ENV=testing
APP_KEY=base64:Gu1p3aWkD5AKA2m3ZDb1Kb0Fx8Rj9lqCkOHVQ6vFhXo=
APP_DEBUG=true

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation_dashboard_test

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BCRYPT_ROUNDS=4
